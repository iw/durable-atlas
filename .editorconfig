root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Written by Gradle.
[*.bat]
end_of_line = crlf

# Golden files, documents and recorded histories that tests compare byte for byte, and files
# taken over as they are: leave them exactly as written.
[{**/src/test/resources/**,**/histories/**,demo/expected/**,**/construct-styles.json,LICENSE,gradlew,**/gradlew}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
